<?xml version="1.0"?>
<package format="3">
  <name>drone_visualization</name>
  <version>0.1.0</version>
  <description>Lightweight quadrotor markers following ROS odometry for Foxglove and RViz.</description>
  <maintainer email="Spaaaace-yyj@users.noreply.github.com">Spaaaace-yyj</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>builtin_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
