<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>driver_interface</name>
  <version>0.1.0</version>
  <description>
    Bridge an industrial RGB camera and PX4 SensorCombined messages to
    VINS-Mono-compatible grayscale Image and Imu topics.
  </description>

  <maintainer email="Spaaaace-yyj@users.noreply.github.com">Spaaaace-yyj</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>px4_msgs</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
