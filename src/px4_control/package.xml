<?xml version="1.0"?>
<package format="3">
  <name>px4_control</name>
  <version>0.3.0</version>
  <description>VINS external vision, explicit PX4 flight management and gated EGO trajectory execution.</description>
  <maintainer email="Spaaaace-yyj@users.noreply.github.com">Spaaaace-yyj</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>px4_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>traj_utils</depend>
  <depend>eigen</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_test</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>

