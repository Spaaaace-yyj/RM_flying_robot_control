FROM ros:humble-ros-base-jammy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /ws

# 先装依赖。以后只改 src/，Docker 可以复用这一层。
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential cmake pkg-config \
      python3-colcon-common-extensions python3-yaml \
      libopencv-dev libeigen3-dev libceres-dev libgoogle-glog-dev \
      libboost-filesystem-dev libboost-program-options-dev libboost-system-dev \
      libusb-1.0-0 \
      ros-humble-ament-cmake-auto \
      ros-humble-cv-bridge \
      ros-humble-image-transport ros-humble-image-transport-plugins \
      ros-humble-camera-info-manager ros-humble-message-filters \
      ros-humble-visualization-msgs \
      ros-humble-tf2-ros ros-humble-rclcpp-components \
      ros-humble-rosidl-default-generators \
      ros-humble-realsense2-camera ros-humble-diagnostic-updater \
      ros-humble-ros2launch ros-humble-rosbag2 \
      ros-humble-rosbag2-storage-default-plugins && \
    rm -rf /var/lib/apt/lists/*

COPY src/ /ws/src/

# 仓库自带厂商 ARM64 相机库，编译和运行使用同一份。
RUN install -m 0755 \
      /ws/src/mindvision_camera/mvsdk/lib/arm64/libMVSDK.so \
      /usr/local/lib/libMVSDK.so && \
    ldconfig

# 包之间顺序编译，每个包最多用 2 个编译任务，减少模拟编译的内存压力。
RUN source /opt/ros/humble/setup.bash && \
    CMAKE_BUILD_PARALLEL_LEVEL=8 MAKEFLAGS=-j8 \
    colcon build \
      --executor sequential \
      --packages-up-to bringup vins_fusion_ros2 d435_bringup pose_graph \
      --cmake-args \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF \
        -DPython3_EXECUTABLE=/usr/bin/python3 && \
    rm -rf /ws/build /ws/log

# docker run 时自动加载 Humble 和项目工作空间。
RUN printf '%s\n' \
      '#!/bin/bash' \
      'set -e' \
      'source /opt/ros/humble/setup.bash' \
      'source /ws/install/setup.bash' \
      'exec "$@"' > /ws/entrypoint.sh && \
    chmod +x /ws/entrypoint.sh

ENTRYPOINT ["/ws/entrypoint.sh"]
CMD ["bash"]